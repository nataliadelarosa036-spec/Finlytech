# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── MySQL ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finpilot

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Finlytech
APP_URL=http://localhost:5173

# ─── Email (Gmail App Password) ───────────────────────────────────────────────
# Genera una App Password en: https://myaccount.google.com/apppasswords
MAIL_USER=tu_correo@gmail.com
MAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
